# Clerk Authentication (Publishable Key from dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Backend API & WebSocket URLs (leave empty for local dev proxy)
# When deploying frontend on Vercel, set these to your Railway backend URL:
# VITE_API_URL=https://your-backend.up.railway.app
# VITE_WS_URL=wss://your-backend.up.railway.app/ws
